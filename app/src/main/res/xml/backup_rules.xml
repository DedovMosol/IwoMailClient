<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. android:allowBackup="false" already disables backup there; the rules
     mirror data_extraction_rules.xml so that turning backup on later cannot leak private data. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
